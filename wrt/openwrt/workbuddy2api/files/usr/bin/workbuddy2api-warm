#!/usr/bin/python3
# -*- coding: utf-8 -*-
"""workbuddy2api 面板缓存预热器（OpenWrt 版）

用量页预热只提交一项后台汇总任务，由它推进共享的日志读取位置。
网关页继续预热分区域概览、性能和账号视图。
开关：uci workbuddy2api.main.warm（默认 1，设 0 跳过）。
日志：只在真的重建过（慢）或失败时写 syslog（cron 每 2 分钟一轮，全部命中不写，
以免刷屏），`logread -e workbuddy2api-warm` 可看。
"""

import json
import subprocess
import sys
import time
import urllib.error
import urllib.request

QUIET = "--quiet" in sys.argv


def log(msg):
    if not QUIET:
        sys.stdout.write("[warm] %s\n" % msg)
        sys.stdout.flush()
    try:
        subprocess.run(["logger", "-t", "workbuddy2api-warm", msg], timeout=10)
    except Exception:
        pass


def uci_get(option, default=None):
    try:
        out = subprocess.run(["uci", "get", "workbuddy2api.main.%s" % option],
                             capture_output=True, text=True, timeout=10)
        value = out.stdout.strip()
        return value if out.returncode == 0 and value else default
    except Exception:
        return default


def request(url, data=None, headers=None, timeout=180):
    req = urllib.request.Request(url, data=data, headers=headers or {})
    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            resp.read()
            return resp.status, time.time() - t0
    except urllib.error.HTTPError as exc:
        try:
            exc.read()
        except Exception:
            pass
        return exc.code, time.time() - t0
    except Exception as exc:
        return None, time.time() - t0


def main():
    if uci_get("warm", "1") == "0":
        log("预热已在 uci 里关闭（workbuddy2api.main.warm=0），跳过")
        return 0

    port = uci_get("port", "8788")
    password = uci_get("panel_password", "")
    base = "http://127.0.0.1:%s" % port

    # 面板密码留空时面板用的是默认密码，预热就跳过（避免无谓的失败登录）
    if not password:
        log("uci 里没有 panel_password，跳过预热")
        return 0

    body = json.dumps({"password": password}).encode("utf-8")
    req = urllib.request.Request(base + "/panel/login", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            token = json.load(resp).get("token", "")
    except urllib.error.HTTPError as exc:
        log("登录失败（http=%s），跳过本轮" % exc.code)
        return 1
    except Exception as exc:
        log("登录出错：%r，跳过本轮" % exc)
        return 1
    if not token:
        log("登录响应里没有 token，跳过")
        return 1

    headers = {"X-Panel-Token": token}
    targets = [
        "/usage/board?range=today",
        "/usage?realm=intl",
        "/usage?realm=cn",
        "/usage/perf?realm=intl",
        "/usage/perf?realm=cn",
        "/usage/by-account",
        # 剩余用量估算：挂 15 秒短 TTL（WB_REMAINING_TTL），预热的价值主要
        # 有两处：进程重启后第一次调用要冷扫全量日志建增量折叠（这台路由器
        # 上约 1~2s），以及把面板每 5 秒一轮的轮询摊薄到一轮重建服务多轮。
        "/usage/remaining",
    ]

    slow = []
    worst = 0.0
    worst_path = ""
    for path in targets:
        code, dt = request(base + path, headers=headers, timeout=300)
        if code != 200:
            log("预热 %s 失败 http=%s (%.1fs)" % (path, code, dt))
            slow.append(path)
        elif dt > worst:
            worst, worst_path = dt, path
    # 正常情况（全部命中、毫秒级）不写 syslog —— cron 每 2 分钟一轮，否则会刷屏；
    # 只有真的重建了（慢）或失败时才记一行，syslog 里留下的都是有信息量的。
    if worst >= 1.0 or slow:
        log("本轮预热完成（%d 个接口，最慢 %.1fs）" % (len(targets), worst))
    if worst >= 20.0:
        log("注意：%s 重建耗时 %.1fs，日志变大后该值会继续上升" % (worst_path, worst))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(1)
